<Project>
  <!-- Fase 1 — Reglas comunes: MSBuild carga este archivo antes de cada .csproj
       que esté debajo de esta carpeta, así que los tres proyectos las heredan. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>                           <!-- avisa de posibles null -->
    <ImplicitUsings>enable</ImplicitUsings>               <!-- using System; etc. automáticos -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>   <!-- una advertencia rompe la compilación -->
    <AnalysisLevel>latest</AnalysisLevel>                 <!-- analizadores de código más recientes -->
    <InvariantGlobalization>true</InvariantGlobalization> <!-- sin datos culturales: 37.5 y no 37,5 -->
  </PropertyGroup>
</Project>
